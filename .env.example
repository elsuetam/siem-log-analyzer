# Diretório base onde os logs brutos serão lidos
SIEM_RAW_LOGS_DIR=data/raw_logs

# Diretório onde dados já parseados/normalizados são armazenados
SIEM_PROCESSED_DIR=data/processed

# Diretório raiz de saída
SIEM_OUTPUT_DIR=output

# Diretório de relatórios gerados
SIEM_REPORTS_DIR=output/reports

# Diretório de dashboards HTML gerados
SIEM_DASHBOARDS_DIR=output/dashboards

# Nível de log da aplicação (DEBUG, INFO, WARNING, ERROR, CRITICAL)
SIEM_LOG_LEVEL=INFO

# Encoding padrão para leitura dos arquivos de log
SIEM_FILE_ENCODING=utf-8

# Timezone usada para normalizar timestamps
SIEM_TIMEZONE=UTC

# --- Thresholds de detecção ---

# Tentativas falhas de login para caracterizar brute force
SIEM_BRUTE_FORCE_ATTEMPTS_THRESHOLD=5

# Janela de tempo (segundos) para contabilizar brute force
SIEM_BRUTE_FORCE_WINDOW_SECONDS=60

# Requisições distintas de um IP para caracterizar scanning
SIEM_SCANNER_REQUESTS_THRESHOLD=20

# Janela de tempo (segundos) para contabilizar scanning
SIEM_SCANNER_WINDOW_SECONDS=10

# Score de risco mínimo (0-100) para que um IP gere um incidente formal
SIEM_INCIDENT_RISK_SCORE_THRESHOLD=25.0

# Habilita o enriquecimento de IPs com dados de geolocalização (requer internet)
SIEM_ENABLE_GEOIP=true

# Timeout (segundos) para a consulta de GeoIP
SIEM_GEOIP_TIMEOUT_SECONDS=5.0

# Diretórios de regras externas (deixe vazio/padrão para usar as regras de exemplo)
SIEM_SIGMA_RULES_DIR=rules/sigma
SIEM_YARA_RULES_DIR=rules/yara

# String de conexão do banco (SQLite por padrão; ex Postgres: postgresql://user:pass@host/db)
SIEM_DATABASE_URL=sqlite:///./siem.db