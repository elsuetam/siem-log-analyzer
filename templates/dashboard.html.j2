<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIEM / Log Analyzer — Dashboard</title>
    <style>
        :root {
            --color-bg: #0f1419;
            --color-surface: #1a2028;
            --color-border: #2a323d;
            --color-text: #e6e6e6;
            --color-text-dim: #8a94a3;
            --color-critical: #e5484d;
            --color-high: #f5a623;
            --color-medium: #f7d154;
            --color-low: #5eb1ef;
            --color-accent: #4dd0a7;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--color-bg);
            color: var(--color-text);
            line-height: 1.5;
            padding: 2rem;
        }

        .container { max-width: 960px; margin: 0 auto; }

        header {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--color-border);
        }

        h1 { font-size: 1.75rem; font-weight: 600; margin-bottom: 0.25rem; }

        .subtitle { color: var(--color-text-dim); font-size: 0.9rem; }

        .summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 1rem;
            margin: 1.5rem 0 2rem;
        }

        .summary-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 1rem;
        }

        .summary-card .value { font-size: 1.75rem; font-weight: 700; }
        .summary-card .label { color: var(--color-text-dim); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; }

        .incident-list { display: flex; flex-direction: column; gap: 0.75rem; }

        .incident-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-left: 4px solid var(--color-accent);
            border-radius: 8px;
            padding: 1rem 1.25rem;
        }

        .incident-card.severity-high { border-left-color: var(--color-high); }
        .incident-card.severity-critical { border-left-color: var(--color-critical); }
        .incident-card.severity-medium { border-left-color: var(--color-medium); }
        .incident-card.severity-low { border-left-color: var(--color-low); }

        .incident-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
        }

        .incident-title { font-weight: 600; font-size: 0.95rem; }

        .score-badge {
            flex-shrink: 0;
            font-weight: 700;
            font-size: 0.85rem;
            padding: 0.2rem 0.6rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.08);
        }

        .incident-meta {
            margin-top: 0.5rem;
            font-size: 0.8rem;
            color: var(--color-text-dim);
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .status-badge {
            text-transform: uppercase;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.03em;
        }

        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: var(--color-text-dim);
        }

        footer {
            margin-top: 2.5rem;
            padding-top: 1rem;
            border-top: 1px solid var(--color-border);
            font-size: 0.75rem;
            color: var(--color-text-dim);
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>SIEM / Log Analyzer</h1>
            <p class="subtitle">Dashboard gerado em {{ generated_at }}</p>
        </header>

        <div class="summary">
            <div class="summary-card">
                <div class="value">{{ incidents|length }}</div>
                <div class="label">Incidentes</div>
            </div>
            <div class="summary-card">
                <div class="value">{{ total_entries }}</div>
                <div class="label">Entradas analisadas</div>
            </div>
            <div class="summary-card">
                <div class="value">{{ total_detections }}</div>
                <div class="label">Detecções brutas</div>
            </div>
        </div>

        {% if incidents %}
        <div class="incident-list">
            {% for incident in incidents %}
            <div class="incident-card severity-{{ incident.highest_severity }}">
                <div class="incident-header">
                    <div class="incident-title">{{ incident.title }}</div>
                    <div class="score-badge">{{ "%.0f"|format(incident.risk_score) }}</div>
                </div>
                <div class="incident-meta">
                    <span>IP: {{ incident.source_ip }}</span>
                    <span>{{ incident.risk_details.contributing_events|length }} evento(s)</span>
                    <span class="status-badge">{{ incident.status.value }}</span>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-state">
            Nenhum incidente identificado nesta análise.
        </div>
        {% endif %}

        <footer>SIEM / Log Analyzer v0.1.0</footer>
    </div>
</body>
</html>