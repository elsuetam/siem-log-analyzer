<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIEM / Log Analyzer — Dashboard</title>
    <style>
        :root {
            --color-bg: #0f1419;
            --color-surface: #1a2028;
            --color-border: #2a323d;
            --color-text: #e6e6e6;
            --color-text-dim: #8a94a3;
            --color-critical: #e5484d;
            --color-high: #f5a623;
            --color-medium: #f7d154;
            --color-low: #5eb1ef;
            --color-accent: #4dd0a7;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--color-bg);
            color: var(--color-text);
            line-height: 1.5;
            padding: 2rem;
        }

        .container { max-width: 960px; margin: 0 auto; }

        header {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--color-border);
        }

        h1 { font-size: 1.75rem; font-weight: 600; margin-bottom: 0.25rem; }
        h2 { font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; }

        .subtitle { color: var(--color-text-dim); font-size: 0.9rem; }

        .summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 1rem;
            margin: 1.5rem 0 2rem;
        }

        .summary-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 1rem;
        }

        .summary-card .value { font-size: 1.75rem; font-weight: 700; }
        .summary-card .label { color: var(--color-text-dim); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; }

        .charts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .chart-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 1.25rem;
        }

        .bar-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.6rem;
        }

        .bar-row:last-child { margin-bottom: 0; }

        .bar-label {
            flex-shrink: 0;
            width: 90px;
            font-size: 0.8rem;
            color: var(--color-text-dim);
            text-align: right;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .bar-track {
            flex-grow: 1;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
            height: 20px;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            border-radius: 4px;
            background: var(--color-accent);
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 6px;
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--color-bg);
            min-width: 24px;
        }

        .bar-fill.severity-critical { background: var(--color-critical); }
        .bar-fill.severity-high { background: var(--color-high); }
        .bar-fill.severity-medium { background: var(--color-medium); }
        .bar-fill.severity-low { background: var(--color-low); }

        .chart-empty {
            color: var(--color-text-dim);
            font-size: 0.85rem;
            text-align: center;
            padding: 1rem 0;
        }

        .incident-list { display: flex; flex-direction: column; gap: 0.75rem; }

        .incident-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-left: 4px solid var(--color-accent);
            border-radius: 8px;
            padding: 1rem 1.25rem;
        }

        .incident-card.severity-high { border-left-color: var(--color-high); }
        .incident-card.severity-critical { border-left-color: var(--color-critical); }
        .incident-card.severity-medium { border-left-color: var(--color-medium); }
        .incident-card.severity-low { border-left-color: var(--color-low); }

        .incident-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
        }

        .incident-title { font-weight: 600; font-size: 0.95rem; }

        .score-badge {
            flex-shrink: 0;
            font-weight: 700;
            font-size: 0.85rem;
            padding: 0.2rem 0.6rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.08);
        }

        .incident-meta {
            margin-top: 0.5rem;
            font-size: 0.8rem;
            color: var(--color-text-dim);
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .status-badge {
            text-transform: uppercase;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.03em;
        }

        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: var(--color-text-dim);
        }

        footer {
            margin-top: 2.5rem;
            padding-top: 1rem;
            border-top: 1px solid var(--color-border);
            font-size: 0.75rem;
            color: var(--color-text-dim);
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>SIEM / Log Analyzer</h1>
            <p class="subtitle">Dashboard gerado em {{ generated_at }}</p>
        </header>

        <div class="summary">
            <div class="summary-card">
                <div class="value">{{ incidents|length }}</div>
                <div class="label">Incidentes</div>
            </div>
            <div class="summary-card">
                <div class="value">{{ total_entries }}</div>
                <div class="label">Entradas analisadas</div>
            </div>
            <div class="summary-card">
                <div class="value">{{ total_detections }}</div>
                <div class="label">Detecções brutas</div>
            </div>
        </div>

        <div class="charts-grid">
            <div class="chart-card">
                <h2>Incidentes por severidade</h2>
                {% if severity_distribution %}
                {% for item in severity_distribution %}
                <div class="bar-row">
                    <div class="bar-label">{{ item.severity }}</div>
                    <div class="bar-track">
                        <div class="bar-fill severity-{{ item.severity }}" style="width: {{ item.percentage }}%">
                            {{ item.count }}
                        </div>
                    </div>
                </div>
                {% endfor %}
                {% else %}
                <div class="chart-empty">Nenhum dado para exibir.</div>
                {% endif %}
            </div>

            <div class="chart-card">
                <h2>Top IPs por risco</h2>
                {% if top_source_ips %}
                {% for item in top_source_ips %}
                <div class="bar-row">
                    <div class="bar-label">{{ item.source_ip }}</div>
                    <div class="bar-track">
                        <div class="bar-fill" style="width: {{ item.percentage }}%">
                            {{ "%.0f"|format(item.score) }}
                        </div>
                    </div>
                </div>
                {% endfor %}
                {% else %}
                <div class="chart-empty">Nenhum dado para exibir.</div>
                {% endif %}
            </div>
        </div>

        {% if incidents %}
        <div class="incident-list">
            {% for incident in incidents %}
            <div class="incident-card severity-{{ incident.highest_severity }}">
                <div class="incident-header">
                    <div class="incident-title">{{ incident.title }}</div>
                    <div class="score-badge">{{ "%.0f"|format(incident.risk_score) }}</div>
                </div>
                <div class="incident-meta">
                    <span>IP: {{ incident.source_ip }}</span>
                    {% if incident.geo_location and not incident.geo_location.is_private and incident.geo_location.country %}
                    <span>📍 {{ incident.geo_location.city or "?" }}, {{ incident.geo_location.country }}</span>
                    {% endif %}
                    <span>{{ incident.risk_details.contributing_events|length }} evento(s)</span>
                    <span class="status-badge">{{ incident.status.value }}</span>
                </div>
                {% set mitre_ids = incident.risk_details.contributing_events
                    | map(attribute="mitre_technique_id") | select() | unique | list %}
                {% if mitre_ids %}
                <div class="incident-meta">
                    <span>MITRE ATT&amp;CK: {{ mitre_ids | join(", ") }}</span>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-state">
            Nenhum incidente identificado nesta análise.
        </div>
        {% endif %}

        <footer>SIEM / Log Analyzer v0.1.0</footer>
    </div>
</body>
</html>